<Window x:Class="VlcControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VLC Control"
        Icon="app.ico"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="PlaylistListBox" TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="PlaylistItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCheckBox" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Background="Transparent" Orientation="Horizontal">
                            <Border
                                x:Name="Box"
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center"
                                Background="#10FFFFFF"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                CornerRadius="5">
                                <TextBlock
                                    x:Name="Check"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="8"
                                    Foreground="#FF16161C"
                                    Text="&#xE73E;"
                                    Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#66FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Border
            Background="#F716161C"
            BorderBrush="#2AFFFFFF"
            BorderThickness="1"
            CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="26"
                    Direction="270"
                    Opacity="0.55"
                    ShadowDepth="6"
                    Color="#FF000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Title bar  -->
                <Grid
                    Grid.Row="0"
                    Height="42"
                    Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel
                        Margin="16,0,8,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{StaticResource Accent}"
                            Text="VLC" />
                        <Ellipse
                            x:Name="Dot"
                            Width="6"
                            Height="6"
                            Margin="8,0,6,0"
                            VerticalAlignment="Center"
                            Fill="{StaticResource MutedBrush}" />
                        <TextBlock
                            x:Name="ConnText"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource MutedBrush}"
                            Text="Подключение…" />
                    </StackPanel>

                    <StackPanel
                        Margin="0,0,7,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            x:Name="PinButton"
                            Click="Pin_Click"
                            Style="{StaticResource GhostIconButton}"
                            ToolTip="Поверх всех окон">
                            <TextBlock
                                x:Name="PinIcon"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="11"
                                Text="&#xE718;" />
                        </Button>
                        <Button
                            Click="Settings_Click"
                            Style="{StaticResource GhostIconButton}"
                            ToolTip="Настройки">
                            <TextBlock
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="12"
                                Text="&#xE713;" />
                        </Button>
                        <Button
                            Click="Minimize_Click"
                            Style="{StaticResource GhostIconButton}"
                            ToolTip="Свернуть">
                            <TextBlock
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="10"
                                Text="&#xE921;" />
                        </Button>
                        <Button
                            Click="Close_Click"
                            Style="{StaticResource CloseButton}"
                            ToolTip="Закрыть">
                            <TextBlock
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="10"
                                Text="&#xE8BB;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  Content  -->
                <Grid Grid.Row="1">
                    <StackPanel x:Name="MainPanel" Margin="16,2,16,16">
                        <!--  Now playing  -->
                        <TextBlock
                            x:Name="TitleText"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"
                            Text="Ничего не воспроизводится"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <TextBlock
                            x:Name="SubText"
                            Margin="0,2,0,0"
                            FontSize="10.5"
                            Foreground="{StaticResource MutedBrush}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="Collapsed" />

                        <!--  Seek  -->
                        <Slider
                            x:Name="SeekSlider"
                            Margin="0,8,0,0"
                            PreviewMouseLeftButtonDown="Seek_PointerDown"
                            PreviewMouseLeftButtonUp="Seek_PointerUp"
                            Style="{StaticResource FlatSlider}"
                            Thumb.DragCompleted="Seek_DragCompleted"
                            Thumb.DragStarted="Seek_DragStarted"
                            ValueChanged="Seek_ValueChanged" />
                        <Grid Margin="0,0,0,2">
                            <TextBlock
                                x:Name="TimeNow"
                                FontSize="10"
                                Foreground="{StaticResource MutedBrush}"
                                Text="0:00" />
                            <TextBlock
                                x:Name="TimeTotal"
                                HorizontalAlignment="Right"
                                FontSize="10"
                                Foreground="{StaticResource MutedBrush}"
                                Text="0:00" />
                        </Grid>

                        <!--  Transport  -->
                        <StackPanel
                            Margin="0,4,0,12"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Click="Previous_Click"
                                Style="{StaticResource TransportButton}"
                                ToolTip="Предыдущий">
                                <TextBlock
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="14"
                                    Text="&#xE892;" />
                            </Button>
                            <Button
                                Margin="4,0"
                                Click="Back10_Click"
                                Content="−10"
                                Style="{StaticResource JumpButton}"
                                ToolTip="Назад 10 секунд" />
                            <Button
                                x:Name="PlayButton"
                                Margin="4,0"
                                Click="PlayPause_Click"
                                Style="{StaticResource PlayButton}"
                                ToolTip="Играть / Пауза">
                                <TextBlock
                                    x:Name="PlayIcon"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="17"
                                    Foreground="#FF16161C"
                                    Text="&#xE768;" />
                            </Button>
                            <Button
                                Margin="4,0"
                                Click="Forward10_Click"
                                Content="+10"
                                Style="{StaticResource JumpButton}"
                                ToolTip="Вперёд 10 секунд" />
                            <Button
                                Click="Next_Click"
                                Style="{StaticResource TransportButton}"
                                ToolTip="Следующий">
                                <TextBlock
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="14"
                                    Text="&#xE893;" />
                            </Button>
                        </StackPanel>

                        <!--  Volume  -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="38" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Width="28"
                                Height="28"
                                Click="Mute_Click"
                                Style="{StaticResource GhostIconButton}"
                                ToolTip="Выключить звук">
                                <TextBlock
                                    x:Name="MuteIcon"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="13"
                                    Text="&#xE767;" />
                            </Button>
                            <Slider
                                x:Name="VolumeSlider"
                                Grid.Column="1"
                                Margin="8,0"
                                Maximum="100"
                                Minimum="0"
                                PreviewMouseLeftButtonDown="Volume_PointerDown"
                                PreviewMouseLeftButtonUp="Volume_PointerUp"
                                Style="{StaticResource FlatSlider}"
                                Thumb.DragCompleted="Volume_DragCompleted"
                                Thumb.DragStarted="Volume_DragStarted"
                                Value="100"
                                ValueChanged="Volume_ValueChanged" />
                            <TextBlock
                                x:Name="VolumeText"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{StaticResource MutedBrush}"
                                Text="100%"
                                TextAlignment="Right" />
                        </Grid>

                        <!--  Speed  -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="10.5"
                                Foreground="{StaticResource MutedBrush}"
                                Text="Скорость" />
                            <StackPanel
                                x:Name="RatePanel"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal" />
                        </Grid>

                        <!--  Playlist  -->
                        <Button Click="PlaylistToggle_Click" Style="{StaticResource PlaylistHeaderButton}">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="11"
                                        Foreground="{StaticResource MutedBrush}"
                                        Text="&#xE8FD;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="10.5"
                                        Foreground="{StaticResource MutedBrush}"
                                        Text="Плейлист" />
                                    <TextBlock
                                        x:Name="PlaylistCount"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{StaticResource DimBrush}"
                                        Text="0" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="Chevron"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="9"
                                    Foreground="{StaticResource MutedBrush}"
                                    Text="&#xE70D;" />
                            </Grid>
                        </Button>

                        <Border
                            x:Name="PlaylistPanel"
                            Margin="0,6,0,0"
                            Padding="4"
                            Background="#0AFFFFFF"
                            CornerRadius="10"
                            Visibility="Collapsed">
                            <Grid>
                                <ListBox
                                    x:Name="PlaylistList"
                                    MaxHeight="172"
                                    ItemContainerStyle="{StaticResource PlaylistItem}"
                                    PreviewMouseLeftButtonUp="Playlist_Click"
                                    Style="{StaticResource PlaylistListBox}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="28">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    x:Name="Bar"
                                                    Background="Transparent"
                                                    CornerRadius="2" />
                                                <TextBlock
                                                    x:Name="ItemName"
                                                    Grid.Column="1"
                                                    Margin="8,0,6,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="11.5"
                                                    Foreground="#D9FFFFFF"
                                                    Text="{Binding Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    Foreground="{StaticResource DimBrush}"
                                                    Text="{Binding DurationText}" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="{StaticResource Accent}" />
                                                    <Setter TargetName="ItemName" Property="Foreground" Value="{StaticResource Accent}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock
                                    x:Name="PlaylistEmpty"
                                    Margin="8"
                                    FontSize="11"
                                    Foreground="{StaticResource DimBrush}"
                                    Text="Плейлист пуст"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!--  Offline card  -->
                    <Border
                        x:Name="OfflineCard"
                        Margin="16,2,16,16"
                        Padding="18,16,18,14"
                        Background="#0AFFFFFF"
                        BorderBrush="#14FFFFFF"
                        BorderThickness="1"
                        CornerRadius="14"
                        Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock
                                x:Name="OfflineIcon"
                                HorizontalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="22"
                                Foreground="{StaticResource Accent}"
                                Text="&#xE7BA;" />
                            <TextBlock
                                x:Name="OfflineTitle"
                                Margin="0,8,0,4"
                                HorizontalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}"
                                Text="VLC не подключён" />
                            <TextBlock
                                x:Name="OfflineText"
                                FontSize="11"
                                Foreground="{StaticResource MutedBrush}"
                                LineHeight="16"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="LaunchButton"
                                Margin="0,12,0,0"
                                Click="Launch_Click"
                                Content="Запустить VLC"
                                Style="{StaticResource PrimaryButton}" />
                            <Button
                                x:Name="RestartButton"
                                Margin="0,12,0,0"
                                Click="Restart_Click"
                                Content="Перезапустить VLC"
                                Style="{StaticResource PrimaryButton}"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="DownloadButton"
                                Margin="0,8,0,0"
                                Click="Download_Click"
                                Content="Скачать VLC"
                                Style="{StaticResource GhostButton}"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="RetryButton"
                                Margin="0,6,0,0"
                                Click="Retry_Click"
                                Content="Проверить снова"
                                Style="{StaticResource GhostButton}" />
                        </StackPanel>
                    </Border>

                    <!--  Settings overlay  -->
                    <Border
                        x:Name="SettingsOverlay"
                        Background="#FC16161C"
                        CornerRadius="15"
                        Visibility="Collapsed">
                        <StackPanel Margin="18,16,18,18">
                            <Grid>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextBrush}"
                                    Text="Настройки" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Click="CloseSettings_Click"
                                    Style="{StaticResource GhostIconButton}"
                                    ToolTip="Закрыть">
                                    <TextBlock
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="10"
                                        Text="&#xE711;" />
                                </Button>
                            </Grid>
                            <TextBlock
                                Margin="0,2,0,12"
                                FontSize="10.5"
                                Foreground="{StaticResource MutedBrush}"
                                Text="HTTP-интерфейс VLC. Обычно менять ничего не нужно." />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="88" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        Margin="2,0,0,4"
                                        FontSize="10"
                                        Foreground="{StaticResource MutedBrush}"
                                        Text="Адрес" />
                                    <TextBox x:Name="HostBox" Style="{StaticResource DarkTextBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock
                                        Margin="2,0,0,4"
                                        FontSize="10"
                                        Foreground="{StaticResource MutedBrush}"
                                        Text="Порт" />
                                    <TextBox x:Name="PortBox" Style="{StaticResource DarkTextBox}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                Margin="2,10,0,4"
                                FontSize="10"
                                Foreground="{StaticResource MutedBrush}"
                                Text="Пароль" />
                            <PasswordBox x:Name="PasswordBox" Style="{StaticResource DarkPasswordBox}" />

                            <CheckBox
                                x:Name="LaunchOnStartBox"
                                Margin="2,12,0,0"
                                Content="Запускать VLC при старте панели"
                                Style="{StaticResource DarkCheckBox}" />

                            <TextBlock
                                x:Name="SettingsStatus"
                                MinHeight="14"
                                Margin="2,10,0,0"
                                FontSize="10.5"
                                Foreground="{StaticResource MutedBrush}"
                                TextWrapping="Wrap" />

                            <Grid Margin="0,10,0,0">
                                <Button
                                    HorizontalAlignment="Left"
                                    Click="CheckConnection_Click"
                                    Content="Проверить"
                                    Style="{StaticResource GhostButton}"
                                    Width="90" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button
                                        Width="80"
                                        Click="CloseSettings_Click"
                                        Content="Отмена"
                                        Style="{StaticResource GhostButton}" />
                                    <Button
                                        Width="96"
                                        Margin="6,0,0,0"
                                        Click="SaveSettings_Click"
                                        Content="Сохранить"
                                        Style="{StaticResource PrimaryButton}"
                                        Height="32" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  Restart confirmation  -->
                    <Border
                        x:Name="ConfirmOverlay"
                        Background="#FC16161C"
                        CornerRadius="15"
                        Visibility="Collapsed">
                        <StackPanel
                            Margin="22,20,22,18"
                            VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="20"
                                Foreground="{StaticResource Accent}"
                                Text="&#xE895;" />
                            <TextBlock
                                Margin="0,8,0,6"
                                HorizontalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}"
                                Text="Перезапустить VLC?" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{StaticResource MutedBrush}"
                                LineHeight="16"
                                Text="VLC будет закрыт и открыт заново с HTTP-интерфейсом. Текущее воспроизведение прервётся."
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <Button
                                Margin="0,14,0,0"
                                Click="ConfirmRestart_Click"
                                Content="Перезапустить"
                                Style="{StaticResource PrimaryButton}" />
                            <Button
                                Margin="0,6,0,0"
                                Click="CancelRestart_Click"
                                Content="Отмена"
                                Style="{StaticResource GhostButton}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
