<Window x:Class="VlcControl.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VLC Control"
        Icon="app.ico"
        Width="620"
        Height="540"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Image Source="app.ico" Width="16" Height="16" />
                    <TextBlock
                        Margin="9,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"
                        Text="VLC Control" />
                </StackPanel>
                <Button
                    x:Name="CloseButton"
                    HorizontalAlignment="Right"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Click="CloseButton_Click"
                    Content="&#xE711;"
                    Style="{StaticResource TitleButton}" />
            </Grid>

            <!-- Welcome -->
            <Grid x:Name="WelcomePanel" Grid.Row="1" Margin="30,4,30,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    FontSize="25"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"
                    Text="{DynamicResource InstallTitle}" />

                <TextBlock
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    FontSize="12.5"
                    Foreground="{StaticResource MutedBrush}"
                    Text="{DynamicResource InstallSubtitle}"
                    TextWrapping="Wrap" />

                <StackPanel Grid.Row="2" Margin="0,20,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                        <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="13" Text="&#x25CF;" />
                        <TextBlock
                            Margin="11,0,0,0"
                            FontSize="13"
                            Foreground="{StaticResource TextBrush}"
                            Text="{DynamicResource FeaturePanel}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                        <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="13" Text="&#x25CF;" />
                        <TextBlock
                            Margin="11,0,0,0"
                            FontSize="13"
                            Foreground="{StaticResource TextBrush}"
                            Text="{DynamicResource FeatureWidget}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="13" Text="&#x25CF;" />
                        <TextBlock
                            Margin="11,0,0,0"
                            FontSize="13"
                            Foreground="{StaticResource TextBrush}"
                            Text="{DynamicResource FeatureAuto}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource MutedBrush}"
                        Text="{DynamicResource Language}" />
                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            x:Name="LangRuButton"
                            Click="LangRu_Click"
                            Content="Русский"
                            Height="28"
                            Padding="12,0"
                            Style="{StaticResource GhostButton}" />
                        <Button
                            x:Name="LangEnButton"
                            Margin="6,0,0,0"
                            Click="LangEn_Click"
                            Content="English"
                            Height="28"
                            Padding="12,0"
                            Style="{StaticResource GhostButton}" />
                    </StackPanel>
                </Grid>

                <Border
                    Grid.Row="4"
                    Margin="0,20,0,0"
                    VerticalAlignment="Top"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="12"
                    Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                x:Name="VlcDot"
                                Width="7"
                                Height="7"
                                Margin="0,0,9,0"
                                VerticalAlignment="Center"
                                Fill="{StaticResource GreenBrush}" />
                            <TextBlock
                                x:Name="VlcStatusText"
                                VerticalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{StaticResource TextBrush}"
                                Text="{DynamicResource VlcFound}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            x:Name="VlcPathText"
                            Margin="16,5,0,0"
                            FontSize="11"
                            Foreground="{StaticResource MutedBrush}"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="DownloadVlcButton"
                            Margin="16,8,0,0"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontSize="12"
                            Foreground="{StaticResource AccentBrush}"
                            Click="DownloadVlc_Click"
                            Content="{DynamicResource DownloadVlc}"
                            Focusable="False">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Root" Background="{TemplateBinding Background}" Padding="0,2">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal" />
                                                <VisualState x:Name="PointerOver">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0" />
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <ContentPresenter Content="{TemplateBinding Content}" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="5" Margin="0,18,0,0">
                    <TextBlock
                        x:Name="InstallPathText"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource MutedBrush}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="InstallButton"
                        HorizontalAlignment="Right"
                        Click="InstallButton_Click"
                        Content="{DynamicResource Install}"
                        Style="{StaticResource PrimaryButton}" />
                </Grid>
            </Grid>

            <!-- Progress -->
            <Grid x:Name="ProgressPanel" Grid.Row="1" Margin="30,4,30,26" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    FontSize="25"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextBrush}"
                    Text="{DynamicResource Installing}" />

                <TextBlock
                    x:Name="StatusText"
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    FontSize="12.5"
                    Foreground="{StaticResource MutedBrush}"
                    Text="{DynamicResource Preparing}"
                    TextWrapping="Wrap" />

                <ProgressBar
                    x:Name="ProgressBar"
                    Grid.Row="2"
                    Margin="0,18,0,0"
                    Style="{StaticResource SetupProgressBar}"
                    Value="0" />

                <StackPanel x:Name="StepsPanel" Grid.Row="3" Margin="0,22,0,0" />

                <TextBlock
                    x:Name="LogText"
                    Grid.Row="5"
                    FontSize="10.5"
                    Foreground="#669999AA"
                    Text=""
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </Grid>

            <!-- Finish -->
            <Grid x:Name="FinishPanel" Grid.Row="1" Margin="30,4,30,26" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="52"
                        Height="52"
                        Background="#1A4CAF50"
                        CornerRadius="26">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="26"
                            Foreground="{StaticResource GreenBrush}"
                            Text="&#xE73E;" />
                    </Border>
                    <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="25"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextBrush}"
                            Text="{DynamicResource Done}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="12.5"
                            Foreground="{StaticResource MutedBrush}"
                            Text="{DynamicResource DoneSubtitle}" />
                    </StackPanel>
                </StackPanel>

                <Border
                    Grid.Row="1"
                    Margin="0,22,0,0"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="12"
                    Padding="16,14">
                    <StackPanel>
                        <TextBlock
                            FontSize="12.5"
                            Foreground="{StaticResource TextBrush}"
                            Text="{DynamicResource HowTo}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="12"
                            Foreground="{StaticResource MutedBrush}"
                            Text="{DynamicResource HowToPanel}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="{StaticResource MutedBrush}"
                            Text="{DynamicResource HowToWidget}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="{StaticResource MutedBrush}"
                            Text="{DynamicResource HowToHttp}" />
                    </StackPanel>
                </Border>

                <TextBlock
                    x:Name="FinishWarningText"
                    Grid.Row="2"
                    Margin="0,14,0,0"
                    FontSize="12"
                    Foreground="#FFFFC46B"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />

                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        x:Name="CloseFinishedButton"
                        Margin="0,0,10,0"
                        Click="CloseButton_Click"
                        Content="{DynamicResource Close}"
                        Style="{StaticResource GhostButton}" />
                    <Button
                        x:Name="OpenPanelButton"
                        Click="OpenPanelButton_Click"
                        Content="{DynamicResource OpenPanel}"
                        Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>

            <!-- Error -->
            <Grid x:Name="ErrorPanel" Grid.Row="1" Margin="30,4,30,26" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="52"
                        Height="52"
                        Background="#1AE5484D"
                        CornerRadius="26">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="24"
                            Foreground="{StaticResource RedBrush}"
                            Text="&#xE7BA;" />
                    </Border>
                    <TextBlock
                        Margin="18,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="25"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}"
                        Text="{DynamicResource ErrorTitle}" />
                </StackPanel>

                <TextBlock
                    x:Name="ErrorText"
                    Grid.Row="1"
                    Margin="0,18,0,0"
                    FontSize="12.5"
                    Foreground="{StaticResource MutedBrush}"
                    TextWrapping="Wrap" />

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Margin="0,0,10,0"
                        Click="CloseButton_Click"
                        Content="{DynamicResource Close}"
                        Style="{StaticResource GhostButton}" />
                    <Button
                        x:Name="RetryButton"
                        Click="RetryButton_Click"
                        Content="{DynamicResource Retry}"
                        Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
