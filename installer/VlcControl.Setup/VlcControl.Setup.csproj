<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <AssemblyName>VLCControl-Setup</AssemblyName>
    <RootNamespace>VlcControl.Setup</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>VLC Control</Product>
    <Description>Установщик панели VLC Control и виджета Xbox Game Bar</Description>
    <Company>Local</Company>
    <ApplicationManifest Condition="'$(TestBuild)' == 'true'">app.test.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(TestBuild)' != 'true'">app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
    <EmbeddedResource Include="payload.zip" Condition="Exists('payload.zip')">
      <LogicalName>payload.zip</LogicalName>
    </EmbeddedResource>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
</Project>
